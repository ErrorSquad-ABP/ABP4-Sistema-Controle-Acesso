# Copie para .env (ignorado pelo git). Validado em src/main/config/env.ts.
NODE_ENV=development
# real (padrao seguro) | demo (somente fora de production, libera qualquer UID)
ACCESS_MODE=real
# Com DATABASE_URL habilita login, pedido QR e historico (JWT_SECRET abaixo, secao Auth).
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Opcional: aparece no GET /health (em CI/CD use o SHA do commit)
APP_VERSION=
# Obrigatorio: 32 bytes aleatorios em hexadecimal, compartilhado
# entre os processos HTTP e MQTT (gere com: openssl rand -hex 32).
QR_TOKEN_SECRET=
# PostgreSQL local (infra/docker-compose.dev.yml) ou Neon.
DATABASE_URL="postgresql://abp4:abp4@localhost:5436/abp4?schema=public"
# Seed de demonstracao (db:seed): so em banco local e nunca em producao.
# Nao existe opt-in para banco remoto; para dados reais use db:provision.
# Provisionamento real (db:provision): primeiro administrador. Passe so na
# execucao do comando; nao deixe a senha gravada em arquivo.
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- MQTT (US-04) ---
# Dev: Mosquitto do infra/docker-compose.dev.yml (porta 1884 no host).
# Prod: HiveMQ Cloud (mqtts://<host>:8883) com usuario e senha.
MQTT_URL=mqtt://localhost:1884
MQTT_USERNAME=
MQTT_PASSWORD=
# Simulador de terminal (npm run sim:terminal)
SIM_TERMINAL_ID=terminal-01
SIM_NFC_UID=04A1B2C3

# --- Auth JWT (US-14) ---
# HS256: minimo de 32 caracteres. Em producao o boot falha com o valor de exemplo.
JWT_SECRET=dev-only-secret-nao-use-em-producao-32
JWT_TTL_SECONDS=3600

# --- Worker MQTT no Render (US-37) ---
# URL publica do web service; so ela habilita o self-ping de keep-alive.
RENDER_EXTERNAL_URL=
# 1 atras de um proxy (Vercel/Render); 0 quando o app e acessado direto.
TRUST_PROXY=0
# DT-13: intervalo do relay da outbox de comandos (ms). 5 s deixa duas tentativas
# dentro dos 10 s de prazo do comando e custa ~12 SELECTs/min por replica.
COMMAND_RELAY_INTERVAL_MS=5000

# DT-21: janela de operacao do relay, no fuso indicado. Fora dela o worker nao
# consulta o banco (o polling continuo impede o Neon de suspender). Nos testes
# e no desenvolvimento local, RELAY_WINDOW_ENABLED=false volta ao modo continuo.
RELAY_WINDOW_ENABLED=true
RELAY_WINDOW_START=18:45
RELAY_WINDOW_END=23:05
RELAY_WINDOW_TZ=America/Sao_Paulo
