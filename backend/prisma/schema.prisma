generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RESIDENT
  VISITOR
}

enum CredentialType {
  QR
  NFC
}

enum AccessMethod {
  QR
  NFC
}

enum AccessDecision {
  GRANTED
  DENIED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorizations        Authorization[] @relation("AuthorizationRecipient")
  createdAuthorizations Authorization[] @relation("AuthorizationCreator")
  credentials           Credential[]
  accessEvents          AccessEvent[]

  @@index([role, active])
}

model AccessLocation {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  radiusMeters  Int      @default(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authorizations Authorization[]
  accessEvents   AccessEvent[]
  terminals      Terminal[]

  @@index([isActive])
}

model Authorization {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  locationId   String    @db.Uuid
  createdById  String?   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  maxUses      Int
  usedCount    Int       @default(0)
  canceledAt   DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User           @relation("AuthorizationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("AuthorizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  location     AccessLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  accessEvents AccessEvent[]

  @@index([userId, startsAt, endsAt])
  @@index([locationId])
  @@index([createdById])
}

model Credential {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  type       CredentialType
  // Armazene somente o hash do token QR ou UID normalizado da tag NFC.
  valueHash  String         @unique
  validFrom  DateTime?
  validUntil DateTime?
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessEvents AccessEvent[]

  @@index([userId, type, revokedAt])
  @@index([validUntil])
}

model AccessEvent {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @db.Uuid
  authorizationId String?        @db.Uuid
  credentialId    String?        @db.Uuid
  locationId      String?        @db.Uuid
  // Identificador recebido sem FK: tentativas de terminais desconhecidos tambem sao auditadas.
  terminalId      String?
  method          AccessMethod
  decision        AccessDecision
  reason          String?
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  distanceMeters  Decimal?       @db.Decimal(10, 2)
  occurredAt      DateTime       @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorization Authorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  credential    Credential?    @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  location      AccessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([locationId, occurredAt])
  @@index([authorizationId])
  @@index([terminalId, occurredAt])
}

model Terminal {
  id         String   @id
  locationId String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location AccessLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  qrTokens TerminalQrToken[]

  @@index([locationId])
}

model TerminalCommand {
  commandId      String   @id @db.Uuid
  requestId      String   @unique @db.Uuid
  terminalId     String
  payload        Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  ackMessageId   String?  @db.Uuid
  ackStatus      String?
  ackReason      String?
  acknowledgedAt DateTime?

  @@index([terminalId, createdAt])
  @@index([expiresAt])
}

model TerminalQrToken {
  valueHash  String   @id
  terminalId String
  expiresAt  DateTime
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
