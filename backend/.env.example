# Copie para .env (ignorado pelo git). Validado em src/main/config/env.ts.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Opcional: aparece no GET /health (em CI/CD use o SHA do commit)
APP_VERSION=
# PostgreSQL local (infra/docker-compose.dev.yml) ou Neon.
DATABASE_URL="postgresql://abp4:abp4@localhost:5436/abp4?schema=public"

# --- MQTT (US-04) ---
# Dev: Mosquitto do infra/docker-compose.dev.yml (porta 1884 no host).
# Prod: HiveMQ Cloud (mqtts://<host>:8883) com usuario e senha.
MQTT_URL=mqtt://localhost:1884
MQTT_USERNAME=
MQTT_PASSWORD=
# Simulador de terminal (npm run sim:terminal)
SIM_TERMINAL_ID=terminal-01
SIM_NFC_UID=04A1B2C3
