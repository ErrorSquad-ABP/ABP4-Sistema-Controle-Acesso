{
  "name": "@abp4/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do Sistema de Controle de Acesso (Express + TypeScript, clean architecture)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:run": "tsc -p tsconfig.seed.json && node .seed-dist/prisma/seed.js",
    "db:provision": "tsc -p tsconfig.seed.json && node --env-file-if-exists=.env .seed-dist/prisma/provision.js",
    "mqtt:consumer": "tsx --env-file-if-exists=.env src/main/mqtt-consumer.ts",
    "sim:terminal": "tsx --env-file-if-exists=.env src/main/sim-terminal.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.3",
    "jose": "^6.2.15",
    "mqtt": "5.16.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "aedes": "1.2.0",
    "dotenv": "18.0.9",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "openapi-types": "12.1.3",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  }
}
